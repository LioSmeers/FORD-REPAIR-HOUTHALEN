---
const currentYear = new Date().getFullYear();
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Algemeen onderhoud en reparatie van Ford-wagens en lichte bestelwagens tot en met 3,5 ton in Houthalen."
    />
    <title>Ford Repair | Ford-specialist in Houthalen</title>
  </head>
  <body>
    <header class="site-nav" aria-label="Hoofdnavigatie">
      <a class="brand" href="#top" aria-label="Ford Repair homepage">
        <span class="brand__name">FORD REPAIR</span>
        <span class="brand__tagline">Onafhankelijk verdeler</span>
      </a>

      <nav class="nav-links" aria-label="Primaire navigatie">
        <a href="#diensten">Diensten</a>
        <a href="#occasies">Occasies</a>
        <a href="#contact">Contact</a>
        <button class="nav-cta" type="button" data-open-appointment>Maak afspraak</button>
      </nav>
    </header>

    <main id="top">
      <section class="hero" aria-label="Ford-specialist in Houthalen">
        <img
          class="hero__image"
          src="/images/hero-garage.png"
          alt="Ford Repair in Houthalen met wagens voor de garage"
          loading="eager"
          decoding="async"
        />
        <div class="hero__shade" aria-hidden="true"></div>

        <div class="hero__inner page-width">
          <div class="hero__content">
            <p class="eyebrow">FORD-SPECIALIST IN HOUTHALEN</p>

            <h1>
              <span>Onderhoud en</span>
              <span>herstellingen.</span>
              <span>Zonder omwegen.</span>
            </h1>

            <p class="hero__description">
              Algemeen onderhoud, diagnose en herstellingen voor Ford-wagens en
              lichte bestelwagens tot en met 3,5 ton.
            </p>

            <div class="hero__actions" aria-label="Contactopties">
              <button class="button button--primary" type="button" data-open-appointment>
                Maak een afspraak
              </button>
              <a class="button button--secondary" href="tel:+32472672647">
                Bel 0472 67 26 47
              </a>
            </div>
          </div>

          <p class="hero__location">EUROPARK 1074 &mdash; HOUTHALEN</p>
        </div>

      </section>

      <section class="core-activity" aria-labelledby="core-activity-title">
        <div class="core-activity__inner page-width">
          <div class="core-activity__copy">
            <p class="section-index">KERN / HOOFDACTIVITEIT</p>
            <h2 id="core-activity-title">Auto's én lichte bestelwagens.</h2>
            <p>
              Algemeen onderhoud en reparatie van auto's en lichte bestelwagens
              tot en met 3,5 ton.
            </p>
          </div>

          <div class="core-activity__stats" aria-labelledby="stats-title">
            <div class="stats__heading">
              <p class="section-index">FORD REPAIR / IN CIJFERS</p>
              <h2 id="stats-title">Ervaring die doorwerkt.</h2>
            </div>

            <div class="stats__grid">
              <article class="stat">
                <p
                  class="stat__value"
                  data-counter
                  data-target="10"
                  data-suffix="+"
                  aria-label="Meer dan 10 jaar ervaring"
                >
                  10+
                </p>
                <p class="stat__label">Jaar ervaring</p>
              </article>

              <article class="stat">
                <p
                  class="stat__value"
                  data-counter
                  data-target="3.5"
                  data-decimals="1"
                  data-suffix=" t"
                  aria-label="Tot en met 3,5 ton voertuiggewicht"
                >
                  3,5 t
                </p>
                <p class="stat__label">Max. voertuiggewicht</p>
              </article>

              <article class="stat">
                <p
                  class="stat__value"
                  data-counter
                  data-target="4"
                  aria-label="Vier kerndiensten"
                >
                  4
                </p>
                <p class="stat__label">Kerndiensten</p>
              </article>
            </div>
          </div>
        </div>
      </section>

      <section class="intro page-width" aria-labelledby="intro-title">
        <p class="section-index">01 / WERKPLAATS</p>
        <div class="intro__copy">
          <h2 id="intro-title">Uw Ford in ervaren handen.</h2>
          <p>
            Rechtstreeks advies, duidelijke afspraken en technisch werk met
            aandacht voor elk detail. Van periodiek onderhoud tot gerichte
            diagnose en herstelling.
          </p>
        </div>
      </section>

      <section class="services section-band" id="diensten" aria-labelledby="services-title">
        <div class="page-width">
          <div class="section-heading">
            <p class="section-index">02 / DIENSTEN</p>
            <h2 id="services-title">Techniek die klopt.<br />Service die duidelijk blijft.</h2>
          </div>

          <div class="service-list">
            <article class="service-row">
              <p class="service-row__number">01</p>
              <h3>Diagnose</h3>
              <p>
                Gericht zoeken naar de oorzaak van storingen en technische
                problemen, met kennis van Ford-systemen.
              </p>
            </article>

            <article class="service-row">
              <p class="service-row__number">02</p>
              <h3>Onderhoud</h3>
              <p>
                Periodiek onderhoud afgestemd op uw wagen, gebruik en
                kilometerstand.
              </p>
            </article>

            <article class="service-row">
              <p class="service-row__number">03</p>
              <h3>Herstellingen</h3>
              <p>
                Mechanische en technische herstellingen voor Ford-wagens, van
                klein herstel tot grondiger werk.
              </p>
            </article>

            <article class="service-row">
              <p class="service-row__number">04</p>
              <h3>Lichte bestelwagens</h3>
              <p>
                Onderhoud en herstellingen met oog voor betrouwbaarheid en een
                snelle terugkeer naar de weg.
              </p>
            </article>
          </div>
        </div>
      </section>

      <section class="workshop page-width" aria-labelledby="workshop-title">
        <div class="workshop__image">
          <img
            src="/images/Engine-detail-optimised.png"
            alt="Detail van een Ford-motor tijdens technisch onderhoud"
            loading="lazy"
            decoding="async"
          />
        </div>

        <div class="workshop__content">
          <p class="section-index">03 / VAKMANSCHAP</p>
          <h2 id="workshop-title">Eerst begrijpen.<br />Dan herstellen.</h2>
          <p>
            Een goede herstelling begint met een correcte diagnose. We bekijken
            wat uw wagen werkelijk nodig heeft en houden de aanpak helder.
          </p>
          <a class="text-link" href="tel:+32472672647">Bespreek uw wagen &rarr;</a>
        </div>
      </section>

      <section class="occasions section-band" id="occasies" aria-labelledby="occasions-title">
        <div class="page-width">
          <div class="section-heading section-heading--split">
            <div>
              <p class="section-index">04 / OCCASIES</p>
              <h2 id="occasions-title">Ford C-Max.</h2>
            </div>
            <p class="section-heading__copy">
              Een helder beeld van de wagen, zonder afleiding. Neem contact op
              voor actuele informatie, beschikbaarheid of een bezichtiging.
            </p>
          </div>

          <div class="occasion-story">
            <div class="vehicle-stage" role="group" aria-label="Twee perspectieven van de Ford C-Max">
              <figure class="vehicle-stage__frame vehicle-stage__frame--first">
                <img
                  src="/images/ford-cmax-cutout-side-rear-view.png"
                  alt="Volledige Ford C-Max vanuit de linker achterzijde bekeken"
                  width="1024"
                  height="768"
                  loading="lazy"
                  decoding="async"
                />
                <figcaption>FORD C-MAX / LINKERACHTERZIJDE</figcaption>
              </figure>

              <figure class="vehicle-stage__frame vehicle-stage__frame--second">
                <img
                  src="/images/ford-cmax-cutout-rear-view.png"
                  alt="Volledige Ford C-Max vanuit de rechter achterzijde bekeken"
                  width="1024"
                  height="768"
                  loading="lazy"
                  decoding="async"
                />
                <figcaption>FORD C-MAX / RECHTERACHTERZIJDE</figcaption>
              </figure>
            </div>

            <div class="occasion-story__steps">
              <article class="occasion-step">
                <p class="section-index">PERSPECTIEF / 01</p>
                <h3>Ruimte en praktisch gebruik.</h3>
                <p>Een veelzijdige Ford met een hoge zit en een helder zicht rondom.</p>
              </article>

              <article class="occasion-step occasion-step--second">
                <p class="section-index">PERSPECTIEF / 02</p>
                <h3>Bekijk hem van dichtbij.</h3>
                <p>Neem contact op voor beschikbaarheid, meer informatie of een bezichtiging.</p>
              </article>
            </div>
          </div>

          <div class="occasion-footer">
            <p>BESCHIKBARE OCCASION</p>
            <a class="button button--primary" href="tel:+32472672647">Vraag informatie</a>
          </div>
        </div>
      </section>

      <section class="location page-width" aria-labelledby="location-title">
        <div class="location__content">
          <p class="section-index">05 / LOCATIE</p>
          <h2 id="location-title">Vlot bereikbaar in Houthalen.</h2>
        </div>

        <div class="location__details">
          <p class="location__label">ADRES</p>
          <address>
            Ford Repair<br />
            Europark 1074<br />
            Houthalen
          </address>
          <a
            class="text-link"
            href="https://www.google.com/maps/search/?api=1&query=Europark+1074+Houthalen"
            target="_blank"
            rel="noreferrer"
          >
            Open route &rarr;
          </a>
        </div>
      </section>

      <section class="contact section-band" id="contact" aria-labelledby="contact-title">
        <div class="contact__inner page-width">
          <p class="section-index">06 / CONTACT</p>
          <h2 id="contact-title">Uw Ford heeft aandacht nodig?</h2>
          <p>Bel ons rechtstreeks of maak een afspraak voor onderhoud, diagnose of herstelling.</p>
          <div class="contact__actions">
            <a class="button button--primary" href="tel:+32472672647">Bel 0472 67 26 47</a>
            <button
              class="button button--secondary"
              type="button"
              data-open-appointment
            >
              Vraag afspraak aan
            </button>
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="page-width site-footer__top">
        <p class="site-footer__name">FORD REPAIR</p>
        <p>Onafhankelijk verdeler</p>
      </div>
      <div class="page-width site-footer__bottom">
        <p>&copy; {currentYear} FORD REPAIR</p>
        <p>EUROPARK 1074 &mdash; HOUTHALEN</p>
        <p>BTW BE0726.692.326</p>
      </div>
    </footer>

    <dialog class="appointment-dialog" id="appointment-dialog" aria-labelledby="appointment-title">
      <button
        class="appointment-dialog__close"
        type="button"
        data-close-appointment
        aria-label="Afspraakformulier sluiten"
      >
        &times;
      </button>

      <div class="appointment-dialog__layout">
        <aside class="appointment-dialog__info">
          <p class="section-index">AFSPRAAK / AANVRAAG</p>
          <h2 id="appointment-title">Plan uw bezoek.</h2>
          <p>
            Kies een voorkeursmoment. Ford Repair bevestigt de afspraak na uw
            aanvraag.
          </p>

          <div class="opening-hours" aria-label="Openingsuren">
            <p class="opening-hours__title">OPENINGSUREN</p>
            <dl>
              <div>
                <dt>Ma &mdash; Vr</dt>
                <dd>08:00 &mdash; 18:00</dd>
              </div>
              <div>
                <dt>Za</dt>
                <dd>08:00 &mdash; 12:00</dd>
              </div>
              <div>
                <dt>Zo</dt>
                <dd>Gesloten</dd>
              </div>
            </dl>
          </div>
        </aside>

        <form class="appointment-form" id="appointment-form">
          <div class="form-field">
            <label for="appointment-name">Naam</label>
            <input id="appointment-name" name="name" type="text" autocomplete="name" required />
          </div>

          <div class="form-field">
            <label for="appointment-phone">Telefoonnummer</label>
            <input
              id="appointment-phone"
              name="phone"
              type="tel"
              autocomplete="tel"
              inputmode="tel"
              required
            />
          </div>

          <div class="form-field">
            <label for="appointment-vehicle">Wagen</label>
            <input
              id="appointment-vehicle"
              name="vehicle"
              type="text"
              placeholder="Model en nummerplaat"
              required
            />
          </div>

          <div class="form-field">
            <label for="appointment-service">Type afspraak</label>
            <select id="appointment-service" name="service" required>
              <option value="">Maak een keuze</option>
              <option>Onderhoud</option>
              <option>Diagnose</option>
              <option>Herstelling</option>
              <option>Lichte bestelwagen</option>
              <option>Andere vraag</option>
            </select>
          </div>

          <div class="form-field">
            <label for="appointment-date">Voorkeursdatum</label>
            <input id="appointment-date" name="date" type="date" required />
          </div>

          <div class="form-field">
            <label for="appointment-time">Voorkeurstijd</label>
            <select id="appointment-time" name="time" disabled required>
              <option value="">Kies eerst een datum</option>
            </select>
          </div>

          <div class="form-field form-field--wide">
            <label for="appointment-message">Extra informatie <span>(optioneel)</span></label>
            <textarea id="appointment-message" name="message" rows="4"></textarea>
          </div>

          <label class="form-consent form-field--wide">
            <input type="checkbox" name="consent" required />
            <span>Ford Repair mag mij contacteren over deze aanvraag.</span>
          </label>

          <div class="appointment-form__footer form-field--wide">
            <p>Uw sms-app opent met de ingevulde aanvraag. De afspraak is pas definitief na bevestiging.</p>
            <button class="button button--primary" type="submit">Verstuur aanvraag</button>
          </div>
        </form>
      </div>
    </dialog>

    <script>
      const appointmentDialog = document.querySelector("#appointment-dialog");
      const appointmentForm = document.querySelector("#appointment-form");
      const appointmentDate = document.querySelector("#appointment-date");
      const appointmentTime = document.querySelector("#appointment-time");
      const appointmentOpeners = document.querySelectorAll("[data-open-appointment]");
      const appointmentCloser = document.querySelector("[data-close-appointment]");

      const formatLocalDate = (date) => {
        const year = date.getFullYear();
        const month = String(date.getMonth() + 1).padStart(2, "0");
        const day = String(date.getDate()).padStart(2, "0");
        return `${year}-${month}-${day}`;
      };

      const createTimeOptions = (closingHour) => {
        const options = [];
        for (let hour = 8; hour < closingHour; hour += 1) {
          options.push(`${String(hour).padStart(2, "0")}:00`);
          options.push(`${String(hour).padStart(2, "0")}:30`);
        }
        return options;
      };

      const updateAvailableTimes = () => {
        if (!appointmentDate || !appointmentTime) return;

        appointmentTime.innerHTML = "";
        appointmentDate.setCustomValidity("");

        if (!appointmentDate.value) {
          appointmentTime.disabled = true;
          appointmentTime.add(new Option("Kies eerst een datum", ""));
          return;
        }

        const selectedDate = new Date(`${appointmentDate.value}T12:00:00`);
        const dayOfWeek = selectedDate.getDay();

        if (dayOfWeek === 0) {
          appointmentTime.disabled = true;
          appointmentTime.add(new Option("Zondag gesloten", ""));
          appointmentDate.setCustomValidity("Ford Repair is op zondag gesloten.");
          appointmentDate.reportValidity();
          return;
        }

        const times = createTimeOptions(dayOfWeek === 6 ? 12 : 18);
        appointmentTime.add(new Option("Kies een tijdstip", ""));
        times.forEach((time) => appointmentTime.add(new Option(time, time)));
        appointmentTime.disabled = false;
      };

      if (appointmentDate) {
        appointmentDate.min = formatLocalDate(new Date());
        appointmentDate.addEventListener("change", updateAvailableTimes);
      }

      appointmentOpeners.forEach((opener) => {
        opener.addEventListener("click", () => {
          if (!appointmentDialog) return;

          if ("showModal" in appointmentDialog) {
            appointmentDialog.showModal();
          } else {
            appointmentDialog.setAttribute("open", "");
          }

          appointmentDialog.querySelector("input")?.focus();
        });
      });

      appointmentCloser?.addEventListener("click", () => appointmentDialog?.close());

      appointmentDialog?.addEventListener("click", (event) => {
        if (event.target === appointmentDialog) appointmentDialog.close();
      });

      appointmentForm?.addEventListener("submit", (event) => {
        event.preventDefault();
        if (!appointmentForm.reportValidity()) return;

        const formData = new FormData(appointmentForm);
        const message = [
          "Afspraakaanvraag Ford Repair",
          `Naam: ${formData.get("name")}`,
          `Telefoon: ${formData.get("phone")}`,
          `Wagen: ${formData.get("vehicle")}`,
          `Type afspraak: ${formData.get("service")}`,
          `Voorkeursmoment: ${formData.get("date")} om ${formData.get("time")}`,
          formData.get("message") ? `Extra informatie: ${formData.get("message")}` : "",
        ]
          .filter(Boolean)
          .join("\n");

        appointmentDialog?.close();
        window.location.href = `sms:+32472672647?body=${encodeURIComponent(message)}`;
      });

      const stage = document.querySelector(".vehicle-stage");
      const secondStep = document.querySelector(".occasion-step--second");
      const desktop = window.matchMedia("(min-width: 901px)");
      let ticking = false;

      const updateImage = () => {
        ticking = false;

        if (!stage || !secondStep || !desktop.matches) {
          stage?.classList.remove("vehicle-stage--second");
          return;
        }

        const switchPoint = window.innerHeight * 0.58;
        const showSecond = secondStep.getBoundingClientRect().top <= switchPoint;
        stage.classList.toggle("vehicle-stage--second", showSecond);
      };

      const requestUpdate = () => {
        if (ticking) return;
        ticking = true;
        window.requestAnimationFrame(updateImage);
      };

      window.addEventListener("scroll", requestUpdate, { passive: true });
      window.addEventListener("resize", requestUpdate);
      desktop.addEventListener("change", requestUpdate);
      requestUpdate();

      const counters = document.querySelectorAll("[data-counter]");
      const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
      const counterAnimations = new WeakMap();

      const formatCounter = (counter, value) => {
        const decimals = Number(counter.dataset.decimals || 0);
        const suffix = counter.dataset.suffix || "";
        return `${value.toFixed(decimals).replace(".", ",")}${suffix}`;
      };

      const animateCounter = (counter) => {
        if (counter.dataset.counted === "true") return;
        counter.dataset.counted = "true";

        const activeFrame = counterAnimations.get(counter);
        if (activeFrame) window.cancelAnimationFrame(activeFrame);

        const target = Number(counter.dataset.target || 0);
        const duration = 1100;
        const startTime = performance.now();

        const updateCounter = (time) => {
          const progress = Math.min((time - startTime) / duration, 1);
          const easedProgress = 1 - Math.pow(1 - progress, 3);
          counter.textContent = formatCounter(counter, target * easedProgress);

          if (progress < 1) {
            const nextFrame = window.requestAnimationFrame(updateCounter);
            counterAnimations.set(counter, nextFrame);
          } else {
            counterAnimations.delete(counter);
          }
        };

        const firstFrame = window.requestAnimationFrame(updateCounter);
        counterAnimations.set(counter, firstFrame);
      };

      const resetCounter = (counter) => {
        const activeFrame = counterAnimations.get(counter);
        if (activeFrame) window.cancelAnimationFrame(activeFrame);

        counterAnimations.delete(counter);
        counter.dataset.counted = "false";
        counter.textContent = formatCounter(counter, 0);
      };

      if (!reducedMotion.matches && "IntersectionObserver" in window) {
        counters.forEach((counter) => {
          counter.textContent = formatCounter(counter, 0);
        });

        const counterObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.intersectionRatio >= 0.45) {
                animateCounter(entry.target);
              } else if (!entry.isIntersecting) {
                resetCounter(entry.target);
              }
            });
          },
          { threshold: [0, 0.45] },
        );

        counters.forEach((counter) => counterObserver.observe(counter));
      }
    </script>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    scroll-behavior: auto;
    background: #000;
    color: #f2f0e9;
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
      "Segoe UI", sans-serif;
  }

  :global(body) {
    margin: 0;
    min-width: 320px;
    overflow-x: clip;
    background: #000;
  }

  :global(a) {
    color: inherit;
  }

  :global(button),
  :global(input),
  :global(select),
  :global(textarea) {
    font: inherit;
  }

  :global(button) {
    color: inherit;
  }

  :global(img) {
    display: block;
    max-width: 100%;
  }

  :global(address) {
    font-style: normal;
  }

  :global(::selection) {
    background: #72a8d8;
    color: #050607;
  }

  :global(:focus-visible) {
    outline: 2px solid #72a8d8;
    outline-offset: 4px;
  }

  .page-width {
    width: min(100% - 96px, 1260px);
    margin-inline: auto;
  }

  main {
    position: relative;
    isolation: isolate;
  }

  main > section:not(.hero) {
    position: relative;
    z-index: 2;
  }

  .site-nav {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 20;
    display: flex;
    width: 100%;
    min-height: 72px;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
    border-bottom: 1px solid #1d1d1d;
    padding: 0 max(48px, calc((100vw - 1260px) / 2));
    background: #000;
  }

  .brand {
    display: grid;
    gap: 4px;
    flex: 0 0 auto;
    text-decoration: none;
  }

  .brand__name,
  .brand__tagline,
  .nav-links,
  .eyebrow,
  .section-index,
  .button,
  .text-link,
  .hero__location,
  .service-row__number,
  figcaption,
  .occasion-footer,
  .site-footer__bottom {
    font-family: ui-monospace, "SFMono-Regular", Consolas, monospace;
  }

  .brand__name {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    line-height: 1;
  }

  .brand__tagline {
    color: #929292;
    font-size: 0.66rem;
    line-height: 1.2;
  }

  .nav-links {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: clamp(18px, 2.4vw, 34px);
    color: #cfcec4;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .nav-links a,
  .nav-links button {
    text-decoration: none;
    white-space: nowrap;
  }

  .nav-cta {
    appearance: none;
    border: 1px solid #72a8d8;
    padding: 9px 12px;
    background: #72a8d8;
    color: #050607;
    cursor: pointer;
  }

  .hero {
    --frame: clamp(12px, 1.6vw, 24px);
    --image-top: 72px;
    position: sticky;
    top: 0;
    z-index: 0;
    isolation: isolate;
    min-height: 100svh;
    overflow: hidden;
    background: #000;
  }

  .hero__image,
  .hero__shade {
    position: absolute;
    top: var(--image-top);
    right: var(--frame);
    bottom: var(--frame);
    left: var(--frame);
    width: calc(100% - (2 * var(--frame)));
    height: calc(100% - var(--image-top) - var(--frame));
  }

  .hero__image {
    z-index: -2;
    object-fit: cover;
    object-position: 54% center;
    filter: saturate(0.82) contrast(1.04);
  }

  .hero__shade {
    z-index: -1;
    background: rgba(4, 5, 6, 0.48);
    pointer-events: none;
  }

  .hero__inner {
    display: grid;
    min-height: 100svh;
    padding: 122px 0 46px;
    grid-template-rows: 1fr auto;
  }

  .hero__content {
    align-self: center;
    width: min(720px, 100%);
    padding-top: 72px;
    padding-left: clamp(20px, 4vw, 72px);
  }

  .eyebrow,
  .section-index {
    margin: 0;
    color: #72a8d8;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    line-height: 1.4;
  }

  .hero .eyebrow {
    margin-bottom: 24px;
  }

  h1,
  h2,
  h3,
  p {
    letter-spacing: 0;
  }

  h1,
  h2,
  h3 {
    font-family: ui-serif, Georgia, Cambria, "Times New Roman", serif;
    font-weight: 400;
  }

  h1 {
    max-width: 720px;
    margin: 0;
    font-size: clamp(2.75rem, 6.2vw, 6rem);
    line-height: 0.92;
  }

  h1 span {
    display: block;
    white-space: nowrap;
  }

  .hero__description {
    max-width: 520px;
    margin: 30px 0 0;
    color: rgba(242, 240, 233, 0.82);
    font-size: clamp(0.95rem, 1.2vw, 1.08rem);
    line-height: 1.6;
  }

  .hero__actions,
  .contact__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 30px;
  }

  .button {
    appearance: none;
    display: inline-flex;
    min-height: 42px;
    align-items: center;
    justify-content: center;
    border: 1px solid transparent;
    padding: 0 15px;
    font-size: 0.68rem;
    font-weight: 600;
    line-height: 1.1;
    text-decoration: none;
    cursor: pointer;
  }

  .button--primary {
    background: #f2f0e9;
    color: #050607;
  }

  .button--secondary {
    border-color: rgba(242, 240, 233, 0.45);
    background: rgba(0, 0, 0, 0.2);
    color: #f2f0e9;
  }

  .hero__location {
    margin: 56px 0 0;
    color: rgba(242, 240, 233, 0.72);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    line-height: 1.45;
  }

  .core-activity {
    border-top: 1px solid #232323;
    border-bottom: 1px solid #232323;
    background: #0c0c0c;
  }

  .core-activity__inner {
    padding-block: 112px;
  }

  .core-activity__copy {
    display: grid;
    grid-template-columns: 1fr 3fr;
    gap: 48px;
    border-top: 1px solid #2a2a2a;
    padding-top: 22px;
  }

  .core-activity__copy .section-index {
    grid-column: 1;
  }

  .core-activity__copy h2 {
    grid-column: 2;
    margin: 0;
    font-size: 4rem;
    line-height: 0.98;
  }

  .core-activity__copy > p:last-child {
    grid-column: 2;
    max-width: 520px;
    margin: 34px 0 0;
    color: #a7a7a2;
    font-size: 1rem;
    line-height: 1.65;
  }

  .core-activity__stats {
    margin-top: 112px;
    border-top: 1px solid #2a2a2a;
    padding-top: 88px;
  }

  .intro {
    display: grid;
    isolation: isolate;
    min-height: 72svh;
    align-items: start;
    grid-template-columns: 1fr 3fr;
    gap: 48px;
    padding-block: clamp(96px, 13vw, 180px);
  }

  .intro::before,
  .workshop::before,
  .location::before {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    z-index: -1;
    width: 100vw;
    background: #000;
    content: "";
    transform: translateX(-50%);
  }

  .intro__copy {
    max-width: 920px;
  }

  .intro h2,
  .section-heading h2,
  .workshop h2,
  .location h2,
  .contact h2 {
    margin: 0;
    font-size: clamp(3rem, 7vw, 7rem);
    line-height: 0.96;
  }

  .intro__copy > p {
    max-width: 570px;
    margin: 48px 0 0 auto;
    color: #a7a7a2;
    font-size: clamp(1rem, 1.5vw, 1.25rem);
    line-height: 1.6;
  }

  .section-band {
    border-top: 1px solid #232323;
    border-bottom: 1px solid #232323;
    background: #0c0c0c;
  }

  .services .page-width,
  .occasions .page-width {
    padding-block: clamp(80px, 10vw, 140px);
  }

  .section-heading {
    display: grid;
    grid-template-columns: 1fr 3fr;
    gap: 48px;
    margin-bottom: clamp(72px, 10vw, 130px);
  }

  .section-heading h2 {
    grid-column: 2;
    max-width: 980px;
  }

  .section-heading .section-index {
    grid-column: 1;
    grid-row: 1;
  }

  .service-list {
    border-bottom: 1px solid #2a2a2a;
  }

  .service-row {
    display: grid;
    min-height: 152px;
    align-items: start;
    grid-template-columns: 0.5fr 1.25fr 1.75fr;
    gap: 32px;
    border-top: 1px solid #2a2a2a;
    padding: 30px 0;
  }

  .service-row__number {
    margin: 7px 0 0;
    color: #72a8d8;
    font-size: 0.68rem;
  }

  .service-row h3 {
    margin: 0;
    font-size: clamp(1.8rem, 3vw, 3rem);
    line-height: 1;
  }

  .service-row > p:last-child {
    max-width: 590px;
    margin: 4px 0 0;
    color: #a7a7a2;
    font-size: 0.98rem;
    line-height: 1.6;
  }

  .stats__heading {
    display: grid;
    grid-template-columns: 1fr 3fr;
    gap: 48px;
    align-items: start;
    margin-bottom: 76px;
  }

  .stats__heading h2 {
    margin: 0;
    font-size: 4rem;
    line-height: 0.98;
  }

  .stats__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid #2a2a2a;
    border-bottom: 1px solid #2a2a2a;
  }

  .stat {
    min-width: 0;
    padding: 30px 28px 34px;
    border-left: 1px solid #2a2a2a;
  }

  .stat:first-child {
    border-left: 0;
    padding-left: 0;
  }

  .stat__value {
    min-height: 1em;
    margin: 0;
    color: #f2f0e9;
    font-family: ui-serif, Georgia, Cambria, "Times New Roman", serif;
    font-size: 6rem;
    font-variant-numeric: tabular-nums;
    line-height: 0.9;
    white-space: nowrap;
  }

  .stat__label {
    margin: 30px 0 0;
    color: #72a8d8;
    font-family: ui-monospace, "SFMono-Regular", Consolas, monospace;
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .workshop {
    display: grid;
    isolation: isolate;
    grid-template-columns: minmax(0, 1.65fr) minmax(320px, 0.85fr);
    gap: clamp(48px, 8vw, 120px);
    align-items: center;
    padding-block: clamp(96px, 12vw, 180px);
  }

  .workshop__image {
    overflow: hidden;
    background: #151515;
  }

  .workshop__image {
    min-height: 720px;
  }

  .workshop__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.78) contrast(1.04);
  }

  .workshop__image img {
    min-height: 720px;
  }

  .workshop__content .section-index {
    margin-bottom: 40px;
  }

  .workshop__content h2 {
    font-size: clamp(2.8rem, 5.5vw, 5.8rem);
  }

  .workshop__content > p:not(.section-index) {
    max-width: 440px;
    margin: 38px 0 0;
    color: #a7a7a2;
    font-size: 1rem;
    line-height: 1.65;
  }

  .text-link {
    display: inline-block;
    margin-top: 36px;
    border-bottom: 1px solid #72a8d8;
    padding-bottom: 6px;
    color: #f2f0e9;
    font-size: 0.7rem;
    text-decoration: none;
  }

  .section-heading--split {
    align-items: end;
  }

  .section-heading--split > div {
    grid-column: 1 / 3;
  }

  .section-heading--split h2 {
    grid-column: auto;
    margin-top: 36px;
  }

  .section-heading__copy {
    grid-column: 3 / 5;
    max-width: 480px;
    margin: 0 0 8px auto;
    color: #a7a7a2;
    line-height: 1.6;
  }

  .occasion-story {
    display: grid;
    grid-template-columns: minmax(0, 1.7fr) minmax(260px, 0.65fr);
    gap: clamp(48px, 7vw, 100px);
    align-items: start;
  }

  .vehicle-stage {
    position: sticky;
    top: 104px;
    display: grid;
    width: 100%;
  }

  .vehicle-stage__frame {
    grid-area: 1 / 1;
    margin: 0;
    transition: opacity 240ms ease-out;
  }

  .vehicle-stage__frame--second {
    opacity: 0;
  }

  .vehicle-stage--second .vehicle-stage__frame--first {
    opacity: 0;
  }

  .vehicle-stage--second .vehicle-stage__frame--second {
    opacity: 1;
  }

  .vehicle-stage__frame img {
    width: 100%;
    height: auto;
  }

  .vehicle-stage__frame figcaption {
    margin-top: 12px;
    color: #777;
    font-size: 0.62rem;
    letter-spacing: 0.06em;
  }

  .occasion-story__steps {
    display: grid;
  }

  .occasion-step {
    display: flex;
    min-height: 72svh;
    flex-direction: column;
    justify-content: center;
    border-top: 1px solid #2a2a2a;
    padding-block: 48px;
  }

  .occasion-step:last-child {
    border-bottom: 1px solid #2a2a2a;
  }

  .occasion-step h3 {
    margin: 30px 0 0;
    font-size: clamp(2rem, 3.4vw, 3.8rem);
    line-height: 1;
  }

  .occasion-step > p:last-child {
    margin: 28px 0 0;
    color: #a7a7a2;
    line-height: 1.6;
  }

  .occasion-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    margin-top: 48px;
    border-top: 1px solid #2a2a2a;
    padding-top: 24px;
    color: #a7a7a2;
    font-size: 0.68rem;
  }

  .occasion-footer p {
    margin: 0;
  }

  .location {
    display: grid;
    isolation: isolate;
    grid-template-columns: minmax(0, 1.7fr) minmax(280px, 0.7fr);
    gap: clamp(48px, 10vw, 150px);
    align-items: end;
    border-top: 1px solid #232323;
    border-bottom: 1px solid #232323;
    padding-block: clamp(96px, 12vw, 180px);
  }

  .location__content .section-index {
    margin-bottom: 40px;
  }

  .location__content h2 {
    max-width: 850px;
    font-size: clamp(2.8rem, 6.2vw, 6.4rem);
  }

  .location__details {
    border-top: 1px solid #2a2a2a;
    padding-top: 20px;
  }

  .location__label {
    margin: 0 0 36px;
    color: #72a8d8;
    font-family: ui-monospace, "SFMono-Regular", Consolas, monospace;
    font-size: 0.68rem;
    letter-spacing: 0.08em;
  }

  .location__details address {
    color: #d3d1ca;
    font-family: ui-serif, Georgia, Cambria, "Times New Roman", serif;
    font-size: clamp(1.8rem, 3vw, 2.8rem);
    line-height: 1.18;
  }

  .contact {
    border-bottom: 0;
  }

  .contact__inner {
    min-height: 86svh;
    padding-block: clamp(96px, 13vw, 180px);
  }

  .contact h2 {
    max-width: 1080px;
    margin-top: clamp(64px, 9vw, 120px);
  }

  .contact__inner > p:not(.section-index) {
    max-width: 560px;
    margin: 42px 0 0;
    color: #a7a7a2;
    font-size: 1.05rem;
    line-height: 1.6;
  }

  .contact__actions {
    margin-top: 38px;
  }

  .site-footer {
    position: relative;
    z-index: 2;
    border-top: 1px solid #232323;
    background: #000;
  }

  .site-footer__top,
  .site-footer__bottom {
    display: flex;
    justify-content: space-between;
    gap: 32px;
  }

  .site-footer__top {
    align-items: end;
    padding-block: clamp(80px, 10vw, 140px);
  }

  .site-footer__top p {
    margin: 0;
    color: #929292;
  }

  .site-footer__name {
    color: #f2f0e9 !important;
    font-family: ui-serif, Georgia, Cambria, "Times New Roman", serif;
    font-size: clamp(3.4rem, 10vw, 10rem);
    line-height: 0.8;
  }

  .site-footer__bottom {
    border-top: 1px solid #232323;
    padding-block: 20px 28px;
    color: #777;
    font-size: 0.62rem;
    letter-spacing: 0.05em;
  }

  .site-footer__bottom p {
    margin: 0;
  }

  .appointment-dialog {
    width: min(calc(100% - 32px), 1080px);
    max-height: calc(100svh - 32px);
    margin: auto;
    overflow: auto;
    border: 1px solid #333;
    padding: 0;
    background: #090909;
    color: #f2f0e9;
  }

  .appointment-dialog::backdrop {
    background: rgba(0, 0, 0, 0.82);
  }

  .appointment-dialog__close {
    position: absolute;
    top: 16px;
    right: 16px;
    z-index: 2;
    display: grid;
    width: 40px;
    height: 40px;
    place-items: center;
    border: 1px solid #3a3a3a;
    padding: 0;
    background: #0c0c0c;
    color: #f2f0e9;
    font-size: 1.4rem;
    line-height: 1;
    cursor: pointer;
  }

  .appointment-dialog__layout {
    display: grid;
    grid-template-columns: minmax(280px, 0.8fr) minmax(0, 1.45fr);
  }

  .appointment-dialog__info {
    border-right: 1px solid #2a2a2a;
    padding: 48px 40px;
    background: #0c0c0c;
  }

  .appointment-dialog__info h2 {
    margin: 52px 0 0;
    font-size: 3.4rem;
    line-height: 0.96;
  }

  .appointment-dialog__info > p:not(.section-index) {
    margin: 30px 0 0;
    color: #a7a7a2;
    font-size: 0.92rem;
    line-height: 1.6;
  }

  .opening-hours {
    margin-top: 64px;
    border-top: 1px solid #2a2a2a;
    padding-top: 20px;
  }

  .opening-hours__title {
    margin: 0 0 24px;
    color: #72a8d8;
    font-family: ui-monospace, "SFMono-Regular", Consolas, monospace;
    font-size: 0.64rem;
    letter-spacing: 0.08em;
  }

  .opening-hours dl {
    display: grid;
    gap: 12px;
    margin: 0;
  }

  .opening-hours dl div {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    color: #cfcec4;
    font-family: ui-monospace, "SFMono-Regular", Consolas, monospace;
    font-size: 0.7rem;
  }

  .opening-hours dt,
  .opening-hours dd {
    margin: 0;
  }

  .opening-hours dd {
    color: #929292;
  }

  .appointment-form {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 22px 18px;
    padding: 74px 42px 42px;
  }

  .form-field {
    display: grid;
    align-content: start;
    gap: 9px;
    min-width: 0;
  }

  .form-field--wide {
    grid-column: 1 / -1;
  }

  .form-field label,
  .form-consent,
  .appointment-form__footer p {
    font-family: ui-monospace, "SFMono-Regular", Consolas, monospace;
    font-size: 0.66rem;
    letter-spacing: 0.03em;
    line-height: 1.45;
  }

  .form-field label {
    color: #cfcec4;
  }

  .form-field label span {
    color: #777;
  }

  .form-field input,
  .form-field select,
  .form-field textarea {
    width: 100%;
    min-width: 0;
    border: 1px solid #333;
    border-radius: 0;
    padding: 12px 13px;
    background: #111;
    color: #f2f0e9;
    color-scheme: dark;
    outline: 0;
  }

  .form-field input,
  .form-field select {
    min-height: 44px;
  }

  .form-field textarea {
    resize: vertical;
  }

  .form-field input::placeholder,
  .form-field textarea::placeholder {
    color: #666;
  }

  .form-field input:focus,
  .form-field select:focus,
  .form-field textarea:focus {
    border-color: #72a8d8;
  }

  .form-field input:user-invalid,
  .form-field select:user-invalid,
  .form-consent input:user-invalid {
    border-color: #b9685f;
  }

  .form-consent {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    color: #929292;
    cursor: pointer;
  }

  .form-consent input {
    width: 16px;
    height: 16px;
    flex: 0 0 auto;
    margin: 1px 0 0;
    accent-color: #72a8d8;
  }

  .appointment-form__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    border-top: 1px solid #2a2a2a;
    padding-top: 22px;
  }

  .appointment-form__footer p {
    max-width: 360px;
    margin: 0;
    color: #777;
  }

  .appointment-form__footer .button {
    flex: 0 0 auto;
  }

  @media (max-width: 900px) {
    .page-width {
      width: min(100% - 48px, 1260px);
    }

    .core-activity__inner {
      padding-block: 88px;
    }

    .core-activity__copy {
      grid-template-columns: 1fr;
    }

    .core-activity__copy .section-index,
    .core-activity__copy h2,
    .core-activity__copy > p:last-child {
      grid-column: 1;
    }

    .core-activity__copy h2 {
      font-size: 3.4rem;
    }

    .stats__heading {
      grid-template-columns: 1fr;
    }

    .stats__heading h2 {
      font-size: 3.4rem;
    }

    .stat__value {
      font-size: 4.5rem;
    }

    .intro,
    .section-heading {
      grid-template-columns: 1fr;
    }

    .intro__copy,
    .section-heading h2,
    .section-heading .section-index,
    .section-heading--split > div,
    .section-heading__copy {
      grid-column: 1;
    }

    .intro__copy > p,
    .section-heading__copy {
      margin-left: 0;
    }

    .section-heading__copy {
      margin-top: 30px;
    }

    .workshop,
    .location {
      grid-template-columns: 1fr;
    }

    .workshop__image,
    .workshop__image img {
      min-height: 560px;
    }

    .location__details {
      max-width: 520px;
    }

    .occasion-story {
      grid-template-columns: 1fr;
    }

    .vehicle-stage {
      position: static;
      gap: 32px;
    }

    .vehicle-stage__frame {
      grid-area: auto;
      opacity: 1;
    }

    .occasion-story__steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 24px;
    }

    .occasion-step {
      min-height: 0;
    }
  }

  @media (max-width: 760px) {
    .page-width {
      width: min(100% - 32px, 1260px);
    }

    .appointment-dialog {
      width: calc(100% - 16px);
      max-height: calc(100svh - 16px);
    }

    .appointment-dialog__layout {
      grid-template-columns: 1fr;
    }

    .appointment-dialog__info {
      border-right: 0;
      border-bottom: 1px solid #2a2a2a;
      padding: 38px 24px;
    }

    .appointment-dialog__info h2 {
      margin-top: 38px;
      font-size: 2.8rem;
    }

    .opening-hours {
      margin-top: 42px;
    }

    .appointment-form {
      grid-template-columns: 1fr;
      padding: 34px 20px 24px;
    }

    .form-field--wide {
      grid-column: 1;
    }

    .appointment-form__footer {
      align-items: stretch;
      flex-direction: column;
    }

    .appointment-form__footer .button {
      width: 100%;
    }

    .core-activity__inner {
      padding-block: 72px;
    }

    .core-activity__copy h2 {
      margin-top: 34px;
      font-size: 2.8rem;
    }

    .core-activity__stats {
      margin-top: 72px;
      padding-top: 64px;
    }

    .stats__heading {
      gap: 40px;
      margin-bottom: 56px;
    }

    .stats__heading h2 {
      font-size: 2.8rem;
    }

    .stats__grid {
      grid-template-columns: 1fr;
    }

    .stat,
    .stat:first-child {
      border-top: 1px solid #2a2a2a;
      border-left: 0;
      padding: 28px 0 30px;
    }

    .stat:first-child {
      border-top: 0;
    }

    .stat__value {
      font-size: 4.2rem;
    }

    .site-nav {
      display: grid;
      min-height: 104px;
      align-content: center;
